    {
      "id": "cypher",
      "slug": "cypher",
      "n": "01",
      "title": "CYPHER",
      "sub": "Magazine & typographic style guide",
      "year": 2024,
      "size": "L",
      "kind": "project",
      "context": "Typography in Context, UTS",
      "team": "Individual",
      "partOf": null,
      "link": null,
      "keywords": [
        "editorial-design",
        "art-direction",
        "magazine",
        "style-guide",
        "indesign",
        "photoshop",
        "procreate",
        "visual-culture",
